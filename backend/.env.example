# ── Required ────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── Database ─────────────────────────────────────────────────────────────────
# Local dev: ./surveylabs.db
# Render (with Disk): /opt/render/project/data/surveylabs.db
DB_PATH=./surveylabs.db

# ── CORS ─────────────────────────────────────────────────────────────────────
# Set to your Vercel frontend URL in production
# Example: https://surveylabs.vercel.app
FRONTEND_URL=http://localhost:5173

# ── Security ─────────────────────────────────────────────────────────────────
# Increase to 12 in production for stronger password hashing
BCRYPT_ROUNDS=10
