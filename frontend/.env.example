# ── Backend API URL ───────────────────────────────────────────────────────────
# Set to your Render backend URL in production
# Example: https://surveylabs-backend.onrender.com/api
VITE_API_URL=http://localhost:3001/api

# ── WebSocket URL ─────────────────────────────────────────────────────────────
# Set to your Render backend WS URL in production
# Example: wss://surveylabs-backend.onrender.com
# Note: Leave blank to use dynamic detection (recommended for production)
VITE_WS_URL=
